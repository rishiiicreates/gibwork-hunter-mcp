# Solana Private Key (Base58 or JSON array [1,2,3...])
# Optional: if omitted, ephemeral keypair is generated for hunter session
SOLANA_PRIVATE_KEY=

# Set to true to connect to live Gibwork External API
GIBWORK_LIVE=false

# Gibwork environment (false for stage, true for production)
GIBWORK_PROD=false

# Optional custom Gibwork API base URL
GIBWORK_API_URL=https://api.gib.work
