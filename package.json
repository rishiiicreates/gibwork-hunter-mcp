{
  "name": "gibwork-hunter-mcp",
  "version": "0.1.0",
  "description": "Autonomous AI agent bounty hunting toolset and MCP server for Gibwork on Solana",
  "keywords": [
    "gibwork",
    "mcp",
    "model-context-protocol",
    "solana",
    "bounty",
    "ai-agent",
    "developer-tooling",
    "claude-desktop",
    "cursor"
  ],
  "author": "Rishii (https://github.com/rishiiicreates)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gibwork-cli": "./dist/cli.js",
    "gibwork-hunter": "./dist/cli.js",
    "gibwork-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rishiiicreates/gibwork-hunter-mcp.git"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@gibwork/sdk": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "tweetnacl": "^1.0.3",
    "uuid": "^11.1.0",
    "zod": "^3.25.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/uuid": "^10.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
